# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit a real token.

# Fine-grained GitHub personal access token, scoped to ONLY this repository.
# For the local app: "Issues: Read and write" is enough.
# For the hosted (Vercel) version: also add "Contents: Read and write"
# (needed so the Content tab can commit copy_bank.json edits).
# Generate one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# owner/repo — only change this if you've forked/renamed the repo.
GITHUB_REPO=dennisscheffel-ux/pfa-book

# Only needed if you want the local app to require a password too (the
# hosted version always requires DASHBOARD_PASSWORD + SECRET_KEY — set as
# Vercel environment variables instead, never in this file).
# DASHBOARD_PASSWORD=
# SECRET_KEY=
