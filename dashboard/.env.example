# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit a real token.

# Fine-grained GitHub personal access token, scoped to ONLY this repository,
# with "Issues: Read and write" permission (nothing else needed). Generate
# one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# owner/repo — only change this if you've forked/renamed the repo.
GITHUB_REPO=dennisscheffel-ux/pfa-book
